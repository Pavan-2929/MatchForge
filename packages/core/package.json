{
  "name": "@matchforge/core",
  "version": "0.2.0",
  "description": "A TypeScript toolkit for string similarity and entity resolution",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pavan-2929/MatchForge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Pavan-2929/MatchForge#readme",
  "bugs": {
    "url": "https://github.com/Pavan-2929/MatchForge/issues"
  },
  "keywords": [
    "string-similarity",
    "string-matching",
    "fuzzy-matching",
    "entity-resolution",
    "record-linkage",
    "data-matching",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "papaparse": "^5.7.1"
  }
}
