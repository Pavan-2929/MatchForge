{
  "name": "@matchforge/core",
  "version": "0.1.0",
  "description": "A toolkit for string similarity and data matching",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Pavan-2929/MatchForge.git",
    "directory": "packages/core"
  },
  "keywords": [
    "string-similarity",
    "string-matching",
    "entity-resolution",
    "data-matching",
    "fuzzy-matching"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc --emitDeclarationOnly",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}